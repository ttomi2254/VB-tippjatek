{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "*.md",
      "*.png",
      "*.log",
      "docs/**",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
