{
  "rules": {
    "config": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('status').val() === 'active' || root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "apiKey": { ".validate": false }
    },
    "configPrivate": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "admins": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('status').val() === 'active' || root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('status').val() === 'active' || root.child('admins').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid)",
        ".validate": "root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('status').val() === 'pending') || (data.exists() && newData.child('status').val() === data.child('status').val())",
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "username": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "email": { ".validate": false }
      }
    },
    "userPrivate": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid)",
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "$other": { ".validate": false }
      }
    },
    "matches": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('status').val() === 'active' || root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "tips": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('status').val() === 'active' || root.child('admins').child(auth.uid).val() === true)",
      "$uid": {
        "$matchId": {
          ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('status').val() === 'active' && !root.child('matches').child($matchId).child('resultHome').exists()",
          ".validate": "newData.hasChildren(['home', 'away'])",
          "home": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "away": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "submittedAt": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },
    "pretournament": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('status').val() === 'active' || root.child('admins').child(auth.uid).val() === true)",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('users').child(auth.uid).child('status').val() === 'active' && !root.child('config').child('tournamentWinner').exists()",
        ".validate": "newData.hasChildren()",
        "topScorer": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "winner": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "submittedAt": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    "testEnv": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
